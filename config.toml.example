# Database configuration
[db]
url = "postgres://username:password@localhost/shurlix"

# Application configuration
[app]
shortened_link_length = 8
allow_anonymous_shorten = true
allow_registering = true
base_url = ""
enable_email_verification = true
email_verification_ttl = "1h"

# Security settings
[security]
# Secret used to sign session JWTs. Must be at least 32 characters long or the
# server refuses to start. Generate one, e.g. with: openssl rand -base64 48
jwt_secret = ""
min_password_strength = 4

# SMTP (Email) configuration
[smtp]
enabled = true # True or False
username = ""
password = ""
from = ""
host = ""
# Optional; omit or set to a number (e.g. 587). An empty string here makes the
# whole config fail to load, since the port must be a number.
# port = 587

# Setup status (don't touch this, it's handled automatically).
[setup]
setup_done = false